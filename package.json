{
  "name": "praneeth-portfolio-angular",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "node scripts/configure-contact.mjs && ng build",
    "build:subpath": "node scripts/configure-contact.mjs && ng build --base-href ./",
    "build:local": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test:contact": "node --test scripts/contact-form.test.mjs scripts/contact-config.test.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "boxicons": "2.1.4"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
